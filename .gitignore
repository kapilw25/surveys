# OS / editor
.DS_Store
*.swp

# python
__pycache__/
*.pyc

# scratch / temp
scratchpad/
*.log

# excluded from the public site repo
#  - literature/: contains full third-party paper text (copyright)
#  - logs/: contains third-party figure screenshots
# literature/
# logs/

# .claude/: share the reusable survey pipeline (commands, hooks, skills) and the
# shared config with collaborators; keep per-user and runtime bits private.
.claude/*
!.claude/commands/
!.claude/hooks/
!.claude/skills/
!.claude/audit/
!.claude/settings.json
# not re-included above, so .claude/* keeps them ignored (per-user / runtime):
#   settings.local.json (personal permission ledger), state/, memory/

# arXiv submission package (large build artifact, regenerated from source on demand)
overleaf_draft/p1_weights_or_skills/weights_or_skills_arxiv.zip

# Secrets & Scripts
.env

# P05: everything under no_upload/ stays local: downloaded third-party arXiv PDFs, raw figure crops
# and licence snapshots (copyright + size). The CC BY tiles the paper uses live in figures/img/.
overleaf_draft/p05_jev_rlcd/no_upload/
# P05 LaTeX intermediates (regenerated by build/build_all.py and build/build_paper.py)
overleaf_draft/p05_jev_rlcd/build/*.pdf
overleaf_draft/p05_jev_rlcd/build/*.aux
overleaf_draft/p05_jev_rlcd/build/*.bbl
overleaf_draft/p05_jev_rlcd/build/*.blg
overleaf_draft/p05_jev_rlcd/build/*.out
overleaf_draft/p05_jev_rlcd/build/*.idx
overleaf_draft/p05_jev_rlcd/build/*.png
overleaf_draft/p05_jev_rlcd/main.aux
overleaf_draft/p05_jev_rlcd/main.out
overleaf_draft/p05_jev_rlcd/main.blg
# P05: verbatim copy of a third-party blog post (copyright); the paper cites the post (almeida2026introducing)
overleaf_draft/p05_jev_rlcd/literature/notes/introduction..md
