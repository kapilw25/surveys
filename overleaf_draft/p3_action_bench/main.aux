\newlabel{sec:method}{{2}{4}{Survey methodology and corpus}{section.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.1}Scope, search, and verification}{4}{subsection.2.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}Placement, definitions, and the core-versus-appendix rule}{4}{subsection.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Corpus construction} in the PRISMA 2020 style\nonbreakingspace \citep  {prisma2020}. The left column is the web-search stream behind the landscape corpus (Table\nonbreakingspace \ref {tab:landscape}): five thematic sweeps, de-duplicated by name and arXiv ID, screened to drop datasets and models, and metadata-verified by parallel audit agents. The right column is the venue-targeted and snowball search behind the closest surveys (Table\nonbreakingspace \ref {tab:survey_compare}). Both streams feed the included set. Candidates whose metadata could not be verified were discarded at harvest; their count was not logged, which we state rather than estimate.\relax }}{5}{figure.caption.6}\protected@file@percent }
\newlabel{fig:prisma}{{3}{5}{\textbf {Corpus construction} in the PRISMA 2020 style~\citep {prisma2020}. The left column is the web-search stream behind the landscape corpus (Table~\ref {tab:landscape}): five thematic sweeps, de-duplicated by name and arXiv ID, screened to drop datasets and models, and metadata-verified by parallel audit agents. The right column is the venue-targeted and snowball search behind the closest surveys (Table~\ref {tab:survey_compare}). Both streams feed the included set. Candidates whose metadata could not be verified were discarded at harvest; their count was not logged, which we state rather than estimate.\relax }{figure.caption.6}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.3}The corpus at a glance}{5}{subsection.2.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Operational definitions used to place each benchmark on the evaluation axes (\S  \ref {sec:method}). They resolve the ambiguous boundary cases: hosting a policy is not the same as \emph  {building} a VLA-vs-world-model contrast ($\gamma $), and an absolute success number is not an advantage-of-prediction measurement ($\delta $) without a matched baseline. \textcolor {magenta!80!black}{\textsf  {open}}\ open-loop, \textcolor {teal!80!black}{\textsf  {closed}}\ closed-loop, \textcolor {violet!80!black}{\textsf  {bridge}}\ bridge.\relax }}{6}{table.caption.7}\protected@file@percent }
\newlabel{tab:defs}{{2}{6}{Operational definitions used to place each benchmark on the evaluation axes (\S \ref {sec:method}). They resolve the ambiguous boundary cases: hosting a policy is not the same as \emph {building} a VLA-vs-world-model contrast ($\gamma $), and an absolute success number is not an advantage-of-prediction measurement ($\delta $) without a matched baseline. \dopen \ open-loop, \dclosed \ closed-loop, \dbridge \ bridge.\relax }{table.caption.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {The catalogued corpus at a glance.} The survey maps 160 web-verified benchmarks across 4 evaluation lanes, spanning 2017--2026 and totalling 164 references; only 11 build an explicit Vision-Language-Action vs world-model contrast. The bars give benchmarks per capability area, with kindred clusters merged (dexterity into manipulation, vision-language navigation into navigation, theory-of-mind into hidden-state); the twelve areas sum to the 160 works of Table\nonbreakingspace \ref {tab:landscape}. Bars are coloured by the dominant lane of each area (teal policy, blue embodied, purple world-model).\relax }}{6}{figure.caption.8}\protected@file@percent }
\newlabel{fig:corpus_overview}{{4}{6}{\textbf {The catalogued corpus at a glance.} The survey maps 160 web-verified benchmarks across 4 evaluation lanes, spanning 2017--2026 and totalling 164 references; only 11 build an explicit Vision-Language-Action vs world-model contrast. The bars give benchmarks per capability area, with kindred clusters merged (dexterity into manipulation, vision-language navigation into navigation, theory-of-mind into hidden-state); the twelve areas sum to the 160 works of Table~\ref {tab:landscape}. Bars are coloured by the dominant lane of each area (teal policy, blue embodied, purple world-model).\relax }{figure.caption.8}{}}
