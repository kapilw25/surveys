\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Capability matrix, one representative benchmark per evaluation lane. No lane's exemplar builds a native VLA-vs-world-model contrast: policy and embodied suites are model-agnostic (they \emph  {host} any policy), world-model suites score generation quality with no action, and the bridge exemplar reaches closed-loop success but reports only a partial contrast (``visual quality is not task success''). Counterfactual probing is absent throughout. \textcolor {ForestGreen}{{\fontfamily  {pzd}\fontencoding  {U}\fontseries  {m}\fontshape  {n}\selectfont  \char 52}}\nonbreakingspace yes, \textcolor {orange!90!black}{\textbf  {\textasciitilde }}\nonbreakingspace partial, \textcolor {BrickRed}{{\fontfamily  {pzd}\fontencoding  {U}\fontseries  {m}\fontshape  {n}\selectfont  \char 56}}\nonbreakingspace no, \textcolor {gray!65}{\textbf  {-{}-}}\nonbreakingspace n/a; \textcolor {magenta!80!black}{\textsf  {open}}\ open-loop, \textcolor {teal!80!black}{\textsf  {closed}}\ closed-loop, \textcolor {violet!80!black}{\textsf  {bridge}}\ bridge.\relax }}{3}{table.caption.3}\protected@file@percent }
\newlabel{tab:matrix}{{4}{3}{Capability matrix, one representative benchmark per evaluation lane. No lane's exemplar builds a native VLA-vs-world-model contrast: policy and embodied suites are model-agnostic (they \emph {host} any policy), world-model suites score generation quality with no action, and the bridge exemplar reaches closed-loop success but reports only a partial contrast (``visual quality is not task success''). Counterfactual probing is absent throughout. \yy ~yes, \pp ~partial, \nn ~no, \dm ~n/a; \dopen \ open-loop, \dclosed \ closed-loop, \dbridge \ bridge.\relax }{table.caption.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces \textbf  {Evaluation-lane comparison matrix}: the four benchmark lanes on six evaluation axes (loop closure, task horizon, capability breadth, model-family contrast, reproducibility, and characteristic blind spot). Marks grade each lane on the axis (\textcolor {ForestGreen}{{\fontfamily  {pzd}\fontencoding  {U}\fontseries  {m}\fontshape  {n}\selectfont  \char 52}}\ favourable, \textcolor {orange!90!black}{\textbf  {\textasciitilde }}\ mixed, \textcolor {BrickRed}{{\fontfamily  {pzd}\fontencoding  {U}\fontseries  {m}\fontshape  {n}\selectfont  \char 56}}\ weak), with an anchoring benchmark per cell. No lane closes the loop, slices capability, \emph  {and} builds a native VLA-vs-world-model contrast at once; the bridge lane comes closest yet still omits the per-capability VLA head-to-head, which is the empty cell this survey names (\S  \ref {sec:gap}).\relax }}{3}{table.caption.4}\protected@file@percent }
\newlabel{tab:branch_limits}{{5}{3}{\textbf {Evaluation-lane comparison matrix}: the four benchmark lanes on six evaluation axes (loop closure, task horizon, capability breadth, model-family contrast, reproducibility, and characteristic blind spot). Marks grade each lane on the axis (\yy \ favourable, \pp \ mixed, \nn \^^Mweak), with an anchoring benchmark per cell. No lane closes the loop, slices capability, \emph {and} builds a native VLA-vs-world-model contrast at once; the bridge lane comes closest yet still omits the per-capability VLA head-to-head, which is the empty cell this survey names (\S \ref {sec:gap}).\relax }{table.caption.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {7}{\ignorespaces \textbf  {Capability deep-dive}: the benchmarks that probe each of the $\beta $ capability cuts, and whether any builds a native VLA-vs-world-model contrast. Hidden-state and counterfactual reasoning are touched by only a handful of benchmarks, and only LIBERO-Mem builds a contrast; every other cut is measured model-agnostically. \textbf  {Eval}: \textcolor {magenta!80!black}{\textsf  {open}}/\textcolor {teal!80!black}{\textsf  {closed}}. \textbf  {VLA vs WM}: \textcolor {ForestGreen}{{\fontfamily  {pzd}\fontencoding  {U}\fontseries  {m}\fontshape  {n}\selectfont  \char 52}}\ native contrast, \textcolor {orange!90!black}{\textbf  {\textasciitilde }}\ partial, \textcolor {gray!65}{\textbf  {-{}-}}\ model-agnostic.\relax }}{3}{table.7}\protected@file@percent }
\newlabel{tab:compare_capability}{{7}{3}{}{table.7}{}}
